<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:title="Sync History"
        app:navigationIcon="?attr/homeAsUpIndicator"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <!-- Filter chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All"
                android:checked="true"
                style="@style/Widget.Material3.Chip.Filter" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipUploaded"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Uploaded"
                style="@style/Widget.Material3.Chip.Filter" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSkipped"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Skipped"
                style="@style/Widget.Material3.Chip.Filter" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFailed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Failed"
                style="@style/Widget.Material3.Chip.Filter" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Empty state -->
    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No sync history yet.\nRun a sync to see results here."
        android:textAlignment="center"
        android:textColor="?android:textColorSecondary"
        android:padding="32dp"
        android:visibility="gone" />

    <!-- Sync log list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSyncLogs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="8dp" />

    <!-- Retry Failed button -->
    <Button
        android:id="@+id/btnRetryFailedHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:text="Retry Failed Files"
        android:textColor="#F44336"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:visibility="gone" />

    <!-- Clear button -->
    <Button
        android:id="@+id/btnClearHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="Clear History"
        style="@style/Widget.Material3.Button.TextButton" />

</LinearLayout>
