<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardElevation="2dp"
    app:cardCornerRadius="14dp"
    app:strokeWidth="1dp"
    app:strokeColor="#1F808080"
    app:cardBackgroundColor="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- Folder icon -->
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_tab_folders"
            android:tint="?attr/colorPrimary"
            android:contentDescription="Sync folder"
            android:layout_marginEnd="14dp" />

        <!-- Folder info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPairLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="?android:textColorPrimary"
                android:ellipsize="middle"
                android:singleLine="true" />

            <TextView
                android:id="@+id/tvPairDrive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="?android:textColorSecondary"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:singleLine="true" />

        </LinearLayout>

        <!-- Remove button -->
        <ImageButton
            android:id="@+id/btnRemovePair"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_delete"
            android:tint="#C62828"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Remove sync folder" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
